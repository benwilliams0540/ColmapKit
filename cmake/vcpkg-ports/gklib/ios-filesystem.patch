 int gk_mkpath(char *pathname)
 {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
   char tmp[2048];
+  char *ptr;
+  struct stat status;
+
+  if (pathname == NULL || pathname[0] == '\0') {
+    errno = EINVAL;
+    return -1;
+  }
+  if (snprintf(tmp, sizeof(tmp), "%s", pathname) >= sizeof(tmp)) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+
+  for (ptr = tmp + 1; *ptr != '\0'; ++ptr) {
+    if (*ptr != '/')
+      continue;
+    *ptr = '\0';
+    if (mkdir(tmp, 0777) != 0 &&
+        (errno != EEXIST || stat(tmp, &status) != 0 ||
+         !S_ISDIR(status.st_mode))) {
+      return -1;
+    }
+    *ptr = '/';
+  }
+
+  if (mkdir(tmp, 0777) != 0 &&
+      (errno != EEXIST || stat(tmp, &status) != 0 ||
+       !S_ISDIR(status.st_mode))) {
+    return -1;
+  }
+  return 0;
+#else
+  char tmp[2048];
 
   sprintf(tmp, "mkdir -p %s", pathname);
   return system(tmp);
+#endif
 }
 
 
 /*************************************************************************
 * This function deletes a directory tree and all of its contents
 **************************************************************************/
 int gk_rmpath(char *pathname)
 {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+  char child[2048];
+  DIR *directory;
+  struct dirent *entry;
+  struct stat status;
+  int error;
+
+  if (pathname == NULL || pathname[0] == '\0') {
+    errno = EINVAL;
+    return -1;
+  }
+  if (lstat(pathname, &status) != 0)
+    return -1;
+  if (!S_ISDIR(status.st_mode) || S_ISLNK(status.st_mode))
+    return unlink(pathname);
+
+  directory = opendir(pathname);
+  if (directory == NULL)
+    return -1;
+
+  errno = 0;
+  while ((entry = readdir(directory)) != NULL) {
+    if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
+      continue;
+    if (snprintf(child, sizeof(child), "%s/%s", pathname, entry->d_name) >=
+        sizeof(child)) {
+      error = ENAMETOOLONG;
+      closedir(directory);
+      errno = error;
+      return -1;
+    }
+    if (gk_rmpath(child) != 0) {
+      error = errno;
+      closedir(directory);
+      errno = error;
+      return -1;
+    }
+    errno = 0;
+  }
+  if (errno != 0) {
+    error = errno;
+    closedir(directory);
+    errno = error;
+    return -1;
+  }
+  if (closedir(directory) != 0)
+    return -1;
+  return rmdir(pathname);
+#else
   char tmp[2048];
 
   sprintf(tmp, "rm -r %s", pathname);
   return system(tmp);
+#endif
 }
